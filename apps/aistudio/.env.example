# Copy to .env. Set a unique name, URLs, ports and volume set for each website.
SITETILLER_INSTANCE=sitetiller
SITETILLER_BIND_ADDRESS=127.0.0.1
SITETILLER_STUDIO_PORT=8080
SITETILLER_PREVIEW_PORT=8081
SITETILLER_PRODUCTION_PORT=8082
SITETILLER_ORIGIN=http://127.0.0.1:8080
SITETILLER_PREVIEW_URL=http://127.0.0.1:8081/
SITETILLER_UI_LANGUAGE=en
# Set these when enabling the optional publish profile:
SITETILLER_PUBLISH_URL=
SITETILLER_PUBLISH_TOKEN=
SITETILLER_PRODUCTION_URL=http://production/
# Studio and preview read publication metadata and snapshots from this fixed Git.
# For existing hosting, set the mount to its bare repository and DIR=/production.
SITETILLER_PRODUCTION_HISTORY_MOUNT=sitetiller_production
SITETILLER_PRODUCTION_HISTORY_DIR=/production/repository.git
SITETILLER_PRODUCTION_GROUP=1000
# Keys can also be entered in the authenticated Settings dialog.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SITETILLER_SITE_URL=
